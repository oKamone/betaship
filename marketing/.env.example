# Anthropic API（投稿文の自動生成・エンゲージメント分析に使用）
ANTHROPIC_API_KEY=

# Meta Threads API
# 取得手順:
#   1. developers.facebook.com → アプリ作成 → Threads API 追加
#   2. アプリにプライベートアカウントを連携
#   3. Graph API Explorer で threads_manage_insights, threads_manage_posts スコープを付与してトークン生成
#   4. 長期トークンに交換: GET https://graph.threads.net/access_token?grant_type=th_exchange_token&client_id=...&client_secret=...&access_token=SHORT_TOKEN
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=      # Threads の数値ユーザーID（Graph API で GET /me?fields=id で確認）

# Betaship Supabase（週次UU取得に使用）
BETASHIP_SUPABASE_URL=https://kphfolcpguniaaefcgcw.supabase.co
BETASHIP_SUPABASE_SERVICE_KEY=

# X (Twitter) API v2 — OAuth 1.0a（autoposter.py 用・任意）
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
